# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Model outputs and training artifacts
outputs/*.pth

# Backup - 只忽略中间检查点，保留最终模型
outputs_backup/checkpoint_enhanced_epoch[1-9].pth
outputs_backup/checkpoint_enhanced_epoch1[0-9].pth
outputs_backup/ct_mesh.html
outputs/*.png
outputs/*.html
outputs/*.jpg
outputs/*.jpeg

# Keep label_map.json and training history
!outputs/label_map.json
!outputs/training_history.json
!outputs/training_history.png
!outputs/sample_visualization.png

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Ignore all sxxxx directories completely
s[0-9][0-9][0-9][0-9]/

# Temporary files
*.tmp
*.bak
*.log

# Weights & Biases
wandb/
**/wandb/
*.wandb
**/*.wandb
scripts/wandb/
