# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Model outputs and training artifacts - ignore checkpoints, keep best
outputs/checkpoint_*.pth
!outputs/best_model.pth

# RL muscle training - ignore checkpoints, keep best model
outputs_rl_muscle/checkpoint_*.pth
!outputs_rl_muscle/best_rl_muscle_model.pth

# Muscle transfer learning - ignore checkpoints, keep best model
outputs_muscle_transfer/checkpoint_*.pth
!outputs_muscle_transfer/best_transfer_model.pth

# Muscle transfer learning V2
outputs_muscle_transfer_v2/checkpoint_*.pth
!outputs_muscle_transfer_v2/best_model.pth

# Muscle transfer learning V3 (expand-then-refine)
outputs_muscle_transfer_v3/checkpoint_*.pth
!outputs_muscle_transfer_v3/best_model.pth

# Muscle transfer learning V4 (attention-based)
outputs_v4/checkpoint_*.pth
!outputs_v4/best_model.pth
outputs_v4/*.png
!outputs_v4/training_history.png

# Backup - 只忽略中间检查点，保留最终模型
outputs_backup/checkpoint_enhanced_epoch[1-9].pth
outputs_backup/checkpoint_enhanced_epoch1[0-9].pth
outputs_backup/ct_mesh.html
outputs/*.png
outputs/*.html
outputs/*.jpg
outputs/*.jpeg

# Keep label_map.json and training history
!outputs/label_map.json
!outputs/training_history.json
!outputs/training_history.png
!outputs/sample_visualization.png

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Ignore all sxxxx directories completely
s[0-9][0-9][0-9][0-9]/

# Temporary files
*.tmp
*.bak
*.log

